# i揭东 mini program local environment template.
# Copy to .env.local (gitignored) and fill local values.
# The WeChat runtime cannot read .env files. Keep this file in sync with
# miniprogram/services/config.ts and override the base URL at runtime with:
#   wx.setStorageSync('ijd:api_base_url', 'http://127.0.0.1:8000/api/v1')
#
# Never place API keys, AppSecret, JWT secret or database passwords here.
API_BASE_URL=http://127.0.0.1:8000/api/v1
DEMO_MODE=true
# Optional. Leave empty in the repository; fill locally for device tests.
MAINTAINER_PHONE=
