.region-hero {
  padding: var(--s-4) var(--s-3);
  background: var(--c-surface);
  border: 1rpx solid var(--c-border);
  border-radius: var(--r-md);
}

.region-hero__top {
  display: flex;
  align-items: flex-start;
  gap: var(--s-2);
}

.region-hero__name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--s-1);
}

.region-hero__name {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--c-text);
}

.region-hero__meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: var(--s-2);
  font-size: 22rpx;
  color: var(--c-text-muted);
}

.region-text {
  margin-top: var(--s-3);
}

.region-text__body {
  font-size: 28rpx;
  line-height: 1.75;
  color: var(--c-text-secondary);
}

.region-text__toggle {
  display: inline-block;
  margin-top: var(--s-2);
  font-size: 24rpx;
}

.region-actions {
  display: flex;
  flex-direction: column;
  gap: var(--s-2);
  margin-top: var(--s-4);
}

.region-footer {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-top: var(--s-4);
  padding-top: var(--s-3);
  border-top: 1rpx solid var(--c-border);
  font-size: 20rpx;
  color: var(--c-text-muted);
  line-height: 1.6;
}
