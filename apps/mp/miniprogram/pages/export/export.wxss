.export-head {
  padding: var(--s-4) var(--s-3);
  background: var(--c-surface);
  border: 1rpx solid var(--c-border);
  border-radius: var(--r-md);
}

.export-head__top {
  display: flex;
  align-items: flex-start;
  gap: var(--s-2);
}

.export-head__title {
  display: block;
  font-size: 42rpx;
  font-weight: 600;
  color: var(--c-text);
}

.export-head__sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--c-text-secondary);
}

.export-guest {
  margin-top: var(--s-3);
}

.export-guest__button {
  margin-top: var(--s-2);
}

.export-preview {
  margin-top: var(--s-3);
}

.export-preview__title {
  margin-bottom: var(--s-2);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
  color: var(--c-text);
}

.format-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--s-2);
}

.format-card {
  position: relative;
  min-height: 180rpx;
  padding: var(--s-3);
  border: 1rpx solid var(--c-border);
  border-radius: var(--r-md);
  background: var(--c-surface);
}

.format-card:active {
  background: var(--c-surface-alt);
}

.format-card--selected {
  border-color: var(--c-primary);
  box-shadow: inset 0 0 0 2rpx var(--c-primary);
}

.format-card--disabled {
  opacity: 0.52;
}

.format-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--s-1);
}

.format-card__label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--c-text);
}

.format-card__check {
  font-size: 18rpx;
  color: var(--c-primary);
}

.format-card__desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--c-text-secondary);
}

.format-card__note {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--c-text-muted);
}

.export-format-note {
  margin-top: var(--s-2);
  line-height: 1.6;
}

.export-actions {
  margin-top: var(--s-3);
}

.export-progress,
.export-result {
  margin-top: var(--s-3);
}

.progress-bar {
  height: 12rpx;
  border-radius: 6rpx;
  background: #e9edf1;
  overflow: hidden;
}

.progress-bar__fill {
  height: 100%;
  border-radius: 6rpx;
  background: var(--c-primary);
  transition: width 0.3s ease;
}

.export-progress__text {
  margin-top: var(--s-2);
  line-height: 1.6;
}

.export-download {
  margin-top: var(--s-3);
}

.export-result__note {
  margin-top: var(--s-2);
  line-height: 1.6;
}

.export-error {
  margin-top: var(--s-3);
}

.export-error .btn {
  margin-top: var(--s-2);
}

.export-rules {
  margin-top: var(--s-3);
}

.export-rules__item {
  position: relative;
  padding-left: 24rpx;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--c-text-secondary);
}

.export-rules__item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 13rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--c-primary);
}

.export-back {
  margin-top: var(--s-4);
}
