.profile-identity {
  border-left: 8rpx solid var(--c-primary);
}

.profile-identity__top {
  display: flex;
  align-items: flex-start;
  gap: var(--s-3);
}

.profile-identity__avatar {
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--c-primary-soft);
  color: var(--c-primary);
  font-size: 40rpx;
  font-weight: 600;
}

.profile-identity__name {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--s-1);
  font-size: 36rpx;
  font-weight: 600;
  color: var(--c-text);
}

.profile-identity__meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--c-text-secondary);
}

.profile-guest-actions {
  margin-top: var(--s-3);
}

.profile-status {
  margin-top: var(--s-3);
}

.profile-status__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--s-2);
  margin-top: var(--s-3);
}

.profile-status__hint {
  margin-top: var(--s-2);
  line-height: 1.6;
}

.profile-status__empty {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--s-2);
}

.profile-reject {
  margin-top: var(--s-2);
}

.timeline {
  margin-top: var(--s-3);
}

.timeline__item {
  display: flex;
  gap: var(--s-2);
}

.timeline__rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 24rpx;
}

.timeline__dot {
  width: 16rpx;
  height: 16rpx;
  margin-top: 8rpx;
  border-radius: 50%;
  border: 2rpx solid var(--c-border-strong);
  background: var(--c-surface);
}

.timeline__dot--done {
  background: var(--c-success);
  border-color: var(--c-success);
}

.timeline__dot--current {
  background: var(--c-primary);
  border-color: var(--c-primary);
}

.timeline__dot--failed {
  background: var(--c-danger);
  border-color: var(--c-danger);
}

.timeline__line {
  flex: 1;
  width: 2rpx;
  min-height: 44rpx;
  background: var(--c-border);
}

.timeline__body {
  flex: 1;
  padding-bottom: var(--s-3);
}

.timeline__label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--c-text);
}

.timeline__time {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--c-text-muted);
}

.timeline__desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--c-danger);
}

.profile-admin {
  display: flex;
  align-items: center;
  gap: var(--s-2);
  margin-top: var(--s-3);
  border-color: #c9dced;
  background: var(--c-info-soft);
}

.profile-admin__title {
  font-size: 30rpx;
  font-weight: 600;
}

.profile-admin__text {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--c-text-secondary);
}

.profile-demo {
  margin-top: var(--s-4);
}

.profile-demo__note {
  margin-top: var(--s-2);
  line-height: 1.6;
}

.profile-logout {
  margin-top: var(--s-4);
}

.profile-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: var(--s-4) 0;
  font-size: 20rpx;
  color: var(--c-text-muted);
}
