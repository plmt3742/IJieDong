.indicator-hero {
  padding: var(--s-4) var(--s-3);
  background: var(--c-surface);
  border: 1rpx solid var(--c-border);
  border-radius: var(--r-md);
}

.indicator-hero__top {
  display: flex;
  align-items: flex-start;
  gap: var(--s-2);
}

.indicator-hero__name {
  display: block;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.3;
  color: var(--c-text);
}

.indicator-hero__meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--s-1);
  margin-top: var(--s-2);
  font-size: 24rpx;
  color: var(--c-text-secondary);
}

.value-card {
  margin-top: var(--s-3);
  border-left: 8rpx solid var(--c-primary);
}

.value-card__label {
  font-size: 24rpx;
  color: var(--c-text-secondary);
}

.value-card__row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 8rpx;
}

.value-card__value {
  font-size: 64rpx;
  font-weight: 600;
  line-height: 1.15;
  letter-spacing: -1rpx;
  color: var(--c-text);
  word-break: break-all;
}

.value-card__unit {
  font-size: 26rpx;
  color: var(--c-text-secondary);
}

.value-card__text {
  margin-top: 12rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--c-text);
}

.value-card__badges {
  display: flex;
  gap: var(--s-1);
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.indicator-guest {
  margin-top: var(--s-3);
}

.compare-button {
  margin-top: var(--s-2);
}

.compare-table {
  margin-top: var(--s-2);
}

.compare-table__value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--c-text);
}

.indicator-actions {
  display: flex;
  flex-direction: column;
  gap: var(--s-2);
  margin-top: var(--s-4);
}

.indicator-footer {
  margin-top: var(--s-3);
  font-size: 20rpx;
  color: var(--c-text-muted);
  line-height: 1.6;
}
