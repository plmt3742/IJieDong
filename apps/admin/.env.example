# API base URL, including the version prefix.
# Absolute URL (default): backend must allow this origin in CORS_ORIGINS.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
#
# Relative URL alternative for local development: uses the Vite /api proxy
# defined in vite.config.ts and needs no backend CORS change.
# VITE_API_BASE_URL=/api/v1
