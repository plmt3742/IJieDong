# i揭东 API - local environment template.
# Copy to .env and fill in locally. Never commit real secrets.

# Application environment: development | test | production
APP_ENV=development

# SQLAlchemy async URL. Demo v0 uses SQLite; production switches to PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Comma-separated allowed origins. Empty means no cross-origin access.
# Local admin dev: http://127.0.0.1:5173
CORS_ORIGINS=

# Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Response/request correlation header.
REQUEST_ID_HEADER=X-Request-ID

# Optional LLM adapter configuration. Leave empty until a provider is approved.
# Values are placeholders only; real keys must stay out of the repository.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# JWT signing secret for local development only. Replace with a strong random
# value outside development; never commit the real secret.
JWT_SECRET=
# Access token lifetime in minutes (default 8 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI agent budgets (see docs/agent/24 section 6.2).
LLM_TIMEOUT_SECONDS=20
AI_MAX_TOOL_CALLS=5
AI_TIMEOUT_SECONDS=30
AI_RATE_LIMIT_PER_MINUTE=10
AI_GUEST_DAILY_LIMIT=5

# Export storage and limits (see docs/agent/25 section 6.6).
EXPORT_DIR=./data/exports
EXPORT_RETENTION_DAYS=7
EXPORT_MAX_ROWS=100
